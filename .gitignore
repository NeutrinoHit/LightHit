# Never commit local inputs, private calibration or derived private responses.
/.local-inputs/
/.build/
/private/
/cache/
.env
.env.*
!.env.example

# Python and Jupyter
/.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
/build/
/dist/

# Quarto and platform files (any depth: docs/ book, slides/ deck)
.quarto/
_site/
_book/
*_files/
.DS_Store

# Local run outputs and rendered reports: regenerate, do not commit.
/results/
/preview/
docs/*.html
slides/*.html
